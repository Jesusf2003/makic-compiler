#ifndef MAKIC_DEFINE_FLAGS
#   error "bad opts.def usage"
#endif

#ifdef MAKIC_TYPE_FLAGS
#endif

#ifdef MAKIC_TYPE_WARNS
    MAKIC_DEFINE_FLAG(UNUSED_VARIABLE)
    MAKIC_DEFINE_FLAG(DEBUG)
#endif

#ifdef MAKIC_TYPE_OPTIMIZATIONS
#endif

#ifdef MAKIC_TYPE_OPTIONS
    MAKIC_DEFINE_FLAG(PROGSRC)
    MAKIC_DEFINE_FLAG(STATE_FPS)
    MAKIC_DEFINE_FLAG(DEBUG)
#endif

#undef MAKIC_TYPE_FLAGS
#undef MAKIC_TYPE_WARNS
#undef MAKIC_TYPE_OPTIONS
#undef MAKIC_TYPE_OPTIMIZATIONS
#undef MAKIC_DEFINE_FLAG